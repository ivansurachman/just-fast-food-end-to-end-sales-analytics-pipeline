# Secrets: real values never enter git. .env.example stays tracked.
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
build/
dist/

# Generated data. Only sample-data/ is tracked.
/data/
tmp-out/
tmp/

# DuckDB files and exports (disposable, rebuilt by backfill)
*.duckdb
*.duckdb.wal
*.parquet

# dbt
dbt/target/
dbt/logs/
dbt/dbt_packages/
# dbt writes a random per-user id here on first run.
.user.yml
logs/

# Airflow runtime (the repo keeps dags/ only)
airflow.cfg
airflow.db
airflow-webserver.pid
webserver_config.py
simple_auth_manager_passwords.json.generated
standalone_admin_password.txt
*.log

# Metabase's embedded H2 database, only from a local run: the stack gives it Postgres.
metabase.db*

# Tool output and local tool state
graphify-out/
.opencode/node_modules/
.opencode/package.json
.opencode/package-lock.json
.opencode/bun.lock

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
