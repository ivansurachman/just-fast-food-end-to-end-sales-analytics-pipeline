# Copy this file to .env and replace every value. .env is gitignored.
# Passwords are consumed by compose interpolation; keep them free of [$"'\].

# --- PostgreSQL -------------------------------------------------------------
# Host port for the container. Change it when a native server already holds 5432.
POSTGRES_HOST_PORT=5432
POSTGRES_PASSWORD=example-superuser-password
POSTGRES_AIRFLOW_PASSWORD=example-airflow-password
POSTGRES_METABASE_PASSWORD=example-metabase-password
POSTGRES_ANALYTICS_PASSWORD=example-analytics-password

# --- SeaweedFS S3 -----------------------------------------------------------
# Keep alphanumeric: the entrypoint writes these into a JSON document.
S3_ACCESS_KEY=jffexampleaccesskey
S3_SECRET_KEY=jffexamplesecretkey
AWS_DEFAULT_REGION=us-east-1

# --- Airflow ----------------------------------------------------------------
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=example-airflow-admin-password
AIRFLOW_ADMIN_EMAIL=admin@example.com
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=replace-with-a-key-generated-by-the-command-above
AIRFLOW_API_SECRET_KEY=replace-with-a-random-string
# Airflow 3 signs internal task tokens with this. Every Airflow process must share one value.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
AIRFLOW_API_AUTH_JWT_SECRET=replace-with-a-random-string-of-at-least-64-bytes
