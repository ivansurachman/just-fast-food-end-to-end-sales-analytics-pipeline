// Gold star schema and the mart layer, as built.
// Fixed layout: every node carries pos, so render with `neato -n2` (no layout pass):
//   podman run --rm -v "$(pwd)/docs:/w" docker.io/library/alpine:3.24.3 sh -c \
//     "apk add --no-cache graphviz >/dev/null && neato -n2 -Tpng /w/er_diagram.dot -o /w/er_diagram.png \
//      && neato -n2 -Tsvg /w/er_diagram.dot -o /w/er_diagram.svg"
// Panel A: order facts with their dimensions. Panel B: coverage and the planned DQ fact.
// Panel C: the five marts PostgreSQL holds for Metabase.
// Notation: a bar marks the "one" side, a crow's foot marks the "many" side.
digraph gold {
  splines=line; outputorder=edgesfirst; dpi=150;
  node [shape=plain, fontname="Helvetica", fontsize=10];
  edge [dir=both, arrowtail=tee, arrowhead=crow, color="#5b6b7a", penwidth=1.3, arrowsize=0.8];

  titleA [label=<<B>A. Order star schema (gold, DuckDB)</B>>, fontsize=14, pos="-20,640!"];
  titleB [label=<<B>B. Branch coverage and the planned DQ fact</B>>, fontsize=14, pos="-20,-70!"];
  titleC [label=<<B>C. Marts (PostgreSQL analytics, read by Metabase)</B>>, fontsize=14, pos="-20,-500!"];

  fact_order [pos="250,330!", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#fff4e0">
    <TR><TD BGCOLOR="#f0a030" COLSPAN="2"><B>fact_order</B> (grain: order)</TD></TR>
    <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">order_id</TD></TR>
    <TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">date_key (local order date)</TD></TR>
    <TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">branch_key</TD></TR>
    <TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">channel_key</TD></TR>
    <TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">promo_key</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">order_ts_local, order_ts_utc, hour_local</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">status_final (completed | cancelled | refunded)</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">refunded_at_local, source_file_date</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">gross_amount, discount_amount, net_amount</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">platform_commission_amount, cogs_amount</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">payment_method, platform_order_ref, dq_flags</TD></TR>
  </TABLE>>];

  fact_order_item [pos="780,330!", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#fff4e0">
    <TR><TD BGCOLOR="#f0a030" COLSPAN="2"><B>fact_order_item</B> (grain: order line)</TD></TR>
    <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">order_id, line_no</TD></TR>
    <TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">date_key</TD></TR>
    <TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">branch_key</TD></TR>
    <TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">menu_item_key</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">order_status_final (denormalized)</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">quantity, unit_price, line_amount</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">unit_cost, line_cogs</TD></TR>
  </TABLE>>];

  dim_date [pos="515,600!", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#e8f1fb">
    <TR><TD BGCOLOR="#5b9bd5" COLSPAN="2"><B>dim_date</B></TD></TR>
    <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">date_key (YYYYMMDD)</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">date, year, month, day</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">weekday_number, weekday_name, is_weekend</TD></TR>
  </TABLE>>];

  dim_branch [pos="515,60!", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#e8f1fb">
    <TR><TD BGCOLOR="#5b9bd5" COLSPAN="2"><B>dim_branch</B></TD></TR>
    <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">branch_key</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">branch_code, branch_name, city, region</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">timezone, outlet_type, size_tier, open_date</TD></TR>
  </TABLE>>];

  dim_channel [pos="-90,480!", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#e8f1fb">
    <TR><TD BGCOLOR="#5b9bd5" COLSPAN="2"><B>dim_channel</B></TD></TR>
    <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">channel_key</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">order_origin, platform, service_type</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">commission_rate</TD></TR>
  </TABLE>>];

  dim_promo [pos="-90,170!", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#e8f1fb">
    <TR><TD BGCOLOR="#5b9bd5" COLSPAN="2"><B>dim_promo</B> (+ NONE member)</TD></TR>
    <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">promo_key</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">promo_name, discount_type, discount_value</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">min_order_amount, max_discount_amount</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">valid_from, valid_to</TD></TR>
  </TABLE>>];

  dim_menu_item [pos="1120,330!", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#e8f1fb">
    <TR><TD BGCOLOR="#5b9bd5" COLSPAN="2"><B>dim_menu_item</B> (+ UNKNOWN member)</TD></TR>
    <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">menu_item_key</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">item_name, category</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">unit_price, unit_cost, is_active</TD></TR>
  </TABLE>>];

  fact_branch_day [pos="515,-200!", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#fff4e0">
    <TR><TD BGCOLOR="#f0a030" COLSPAN="2"><B>fact_branch_day</B> (grain: branch x day)</TD></TR>
    <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">date_key, branch_key</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">is_expected (branch open that day)</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">orders_received, late_arrival_orders</TD></TR>
  </TABLE>>];

  dim_date_b [pos="60,-200!", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#e8f1fb">
    <TR><TD BGCOLOR="#5b9bd5" COLSPAN="2"><B>dim_date</B> <I>(same table as in A)</I></TD></TR>
    <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">date_key</TD></TR>
  </TABLE>>];

  dim_branch_b [pos="970,-200!", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#e8f1fb">
    <TR><TD BGCOLOR="#5b9bd5" COLSPAN="2"><B>dim_branch</B> <I>(same table as in A)</I></TD></TR>
    <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">branch_key</TD></TR>
  </TABLE>>];

  fact_dq_daily [pos="515,-360!", style="rounded,dashed", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#eeeeee">
    <TR><TD COLSPAN="2"><B>fact_dq_daily</B> <I>(planned, not built: M18 deferred)</I></TD></TR>
    <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">file_date, entity, defect_type</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">rows_in, rows_flagged, rows_quarantined</TD></TR>
    <TR><TD COLSPAN="2" ALIGN="LEFT"><I>would be standalone, no foreign keys</I></TD></TR>
  </TABLE>>];

  // Panel C: the marts. They are aggregates, so they carry no foreign keys to gold; the grain and
  // the primary key are what a reader needs.
  mart_sales [pos="10,-640!", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#eaf6ea">
    <TR><TD COLSPAN="2" BGCOLOR="#6aa84f"><B>mart_sales_day_branch_channel</B></TD></TR>
    <TR><TD COLSPAN="2"><I>grain: date x branch x channel</I></TD></TR>
    <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">order_date, branch_key, channel_key</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">total_orders, completed_orders</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">cancelled_orders, refunded_orders</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">gross_amount, discount_amount</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">net_amount, cogs_amount</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">commission_amount</TD></TR>
  </TABLE>>];

  mart_hourly [pos="380,-640!", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#eaf6ea">
    <TR><TD COLSPAN="2" BGCOLOR="#6aa84f"><B>mart_hourly</B></TD></TR>
    <TR><TD COLSPAN="2"><I>grain: date x branch x hour</I></TD></TR>
    <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">order_date, branch_key, hour_local</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">total_orders</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">completed_orders</TD></TR>
  </TABLE>>];

  mart_item [pos="750,-640!", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#eaf6ea">
    <TR><TD COLSPAN="2" BGCOLOR="#6aa84f"><B>mart_item_day</B></TD></TR>
    <TR><TD COLSPAN="2"><I>grain: date x menu item</I></TD></TR>
    <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">order_date, menu_item_key</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">quantity, line_amount</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">line_cogs</TD></TR>
  </TABLE>>];

  mart_promo [pos="1120,-640!", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#eaf6ea">
    <TR><TD COLSPAN="2" BGCOLOR="#6aa84f"><B>mart_promo_day</B></TD></TR>
    <TR><TD COLSPAN="2"><I>grain: date x promo x channel</I></TD></TR>
    <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">order_date, promo_key, channel_key</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">order_count, gross_amount</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">discount_amount, net_amount</TD></TR>
  </TABLE>>];

  mart_coverage [pos="1490,-640!", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#eaf6ea">
    <TR><TD COLSPAN="2" BGCOLOR="#6aa84f"><B>mart_branch_coverage</B></TD></TR>
    <TR><TD COLSPAN="2"><I>grain: date x branch</I></TD></TR>
    <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">order_date, branch_key</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">is_expected, orders_received</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">late_arrival_orders, completed_orders</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">net_amount</TD></TR>
  </TABLE>>];

  noteC [pos="750,-800!", shape=plain, label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="2"><TR><TD><I>Aggregated from fact_order, fact_order_item and fact_branch_day by load_marts (DELETE window + COPY, one transaction per table).<BR/>Metabase reads them as the read-only role analytics_ro; each has an index on order_date.</I></TD></TR></TABLE>>];

  // Panel A
  dim_date:sw -> fact_order:n;
  dim_date:se -> fact_order_item:n;
  dim_branch:nw -> fact_order:s;
  dim_branch:ne -> fact_order_item:s;
  dim_channel:e -> fact_order:nw;
  dim_promo:e -> fact_order:sw;
  dim_menu_item:w -> fact_order_item:e;
  fact_order:e -> fact_order_item:w;
  // Panel B
  dim_date_b:e -> fact_branch_day:w;
  dim_branch_b:w -> fact_branch_day:e;
}
