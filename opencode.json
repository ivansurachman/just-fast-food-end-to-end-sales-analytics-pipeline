{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4.1-flash",
  "autoupdate": false,
  "share": "disabled",
  "instructions": ["docs/pipeline-design.md"],
  "permission": {
    "skill": {
      "*": "deny",
      "lean-code": "allow",
      "podman-windows": "allow",
      "debug-protocol": "allow"
    },
    "bash": {
      "git push*": "deny",
      "git reset --hard*": "ask",
      "git clean*": "ask",
      "wsl*": "ask",
      "podman system prune*": "deny",
      "podman volume prune*": "deny",
      "podman machine rm*": "deny",
      "podman volume rm*": "ask",
      "podman compose down*-v*": "ask",
      "podman-compose down*-v*": "ask"
    }
  }
}